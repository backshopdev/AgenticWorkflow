{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "general": { "disable": true },
    "explore": { "disable": true },
    "orchestrator": {
      "mode": "primary",
      "steps": 200,
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": {
          "*": "deny",
          "investigator": "allow",
          "document-author": "allow",
          "reviewer": "allow"
        },
        "skill": {
          "*": "deny",
          "commit-convention": "allow",
          "planning-structure": "allow",
          "review-findings": "allow"
        }
      }
    },
    "investigator": {
      "mode": "subagent",
      "temperature": 0.2,
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": {
          "*": "deny",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "git diff": "allow",
          "git diff *": "allow"
        },
        "task": "deny",
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "allow"
      }
    },
    "document-author": {
      "mode": "subagent",
      "temperature": 0.3,
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "bash": {
          "*": "ask",
          "node .opencode/docs-check.js": "allow",
          "node .opencode/docs-check.js *": "allow",
          "npx --yes markdownlint-cli2@0.23.2": "allow",
          "npx --yes markdownlint-cli2@0.23.2 *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git status": "allow",
          "git status *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git commit": "ask",
          "git commit *": "ask",
          "git commit --amend": "ask",
          "git commit --amend *": "ask",
          "git commit * --amend": "ask",
          "git commit * --amend *": "ask",
          "git push": "ask",
          "git push *": "ask",
          "git commit --no-verify": "deny",
          "git commit --no-verify *": "deny",
          "git commit * --no-verify": "deny",
          "git commit * --no-verify *": "deny",
          "git commit -n": "deny",
          "git commit -n *": "deny",
          "git commit * -n": "deny",
          "git commit * -n *": "deny",
          "git -c * commit": "deny",
          "git -c * commit *": "deny",
          "git push --force*": "deny",
          "git push * --force*": "deny",
          "git push -f": "deny",
          "git push -f *": "deny",
          "git push * -f": "deny",
          "git push * -f *": "deny",
          "git push +*": "deny",
          "git push * +*": "deny",
          "git push --no-verify": "deny",
          "git push --no-verify *": "deny",
          "git push * --no-verify": "deny",
          "git push * --no-verify *": "deny",
          "git push --mirror": "deny",
          "git push --mirror *": "deny",
          "git push * --mirror": "deny",
          "git push * --mirror *": "deny"
        },
        "webfetch": "ask",
        "websearch": "allow",
        "task": "deny",
        "skill": {
          "*": "deny",
          "repository-documentation": "allow",
          "docs-check": "allow",
          "docs-publish": "allow",
          "commit-convention": "allow",
          "planning-structure": "allow",
          "decision-record": "allow",
          "specification": "allow",
          "implementation-plan": "allow",
          "architecture-document": "allow",
          "implementation-map": "allow",
          "contract-design": "allow",
          "openapi": "allow",
          "json-schema": "allow",
          "contract-guide": "allow",
          "contract-publication": "allow",
          "security-privacy": "allow",
          "accessibility": "allow",
          "quality-attributes": "allow",
          "software-architecture": "allow",
          "software-design": "allow",
          "design-for-testability": "allow",
          "api-compatibility": "allow",
          "apostrophe-cms": "allow",
          "astro": "allow",
          "react": "allow",
          "javascript": "allow",
          "typescript": "allow",
          "semantic-html": "allow",
          "css-sass": "allow",
          "image-media-delivery": "allow",
          "web-performance": "allow",
          "seo-structured-data": "allow",
          "git-commit": "allow"
        }
      }
    },
    "reviewer": {
      "mode": "subagent",
      "temperature": 0.1,
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "ask",
        "websearch": "allow",
        "skill": {
          "*": "deny",
          "peer": "allow",
          "security": "allow",
          "review-findings": "allow",
          "decision-quality": "allow",
          "behavioral-completeness": "allow",
          "gherkin-testability": "allow",
          "requirements-traceability": "allow",
          "architectural-coherence": "allow",
          "repository-accuracy": "allow",
          "contract-completeness": "allow",
          "security-privacy": "allow",
          "accessibility": "allow",
          "quality-attributes": "allow",
          "software-architecture": "allow",
          "software-design": "allow",
          "design-for-testability": "allow",
          "api-compatibility": "allow",
          "apostrophe-cms": "allow",
          "astro": "allow",
          "react": "allow",
          "javascript": "allow",
          "typescript": "allow",
          "semantic-html": "allow",
          "css-sass": "allow",
          "image-media-delivery": "allow",
          "web-performance": "allow",
          "seo-structured-data": "allow"
        }
      }
    }
  }
}
